NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only — never expose with a NEXT_PUBLIC_ prefix.
# Found in Supabase: Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Any string you choose. Required to view /admin (service requests).
ADMIN_ACCESS_CODE=choose-a-strong-code
